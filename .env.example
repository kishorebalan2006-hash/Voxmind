# VoxMind FastAPI Backend Environment Configuration

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# API Metadata
APP_NAME=VoxMind API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:50000"]

# Firebase Configuration
FIREBASE_PROJECT_ID=voxmind-production
# Path to service account credentials (leave empty to use Application Default Credentials or Mock in dev)
FIREBASE_CREDENTIALS_PATH=

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
